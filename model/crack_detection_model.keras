  )\n","\n","    y_true.extend(\n","        labels.numpy()\n","    )\n","\n","    y_pred_prob.extend(\n","        predictions.flatten()\n","    )\n","\n","y_true = np.array(y_true)\n","y_pred_prob = np.array(y_pred_prob)"],"metadata":{"id":"k7pnbuLHamHy"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["y_pred = (\n","    y_pred_prob >= 0.5\n",").astype(int)"],"metadata":{"id":"zf3sAfU4cT8P"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["print(\"Actual classes:\", set(y_true))\n","print(\"Predicted classes:\", set(y_pred))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"GHOLdjBQfscG","executionInfo":{"status":"ok","timestamp":1789841455657,"user_tz":-330,"elapsed":22,"user":{"displayName":"Revathi Muthukrishnan","userId":"10138192370439535374"}},"outputId":"e3ae5977-f029-4a1f-b2ec-2239fd28c0c9"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Actual classes: {np.int64(1)}\n","Predicted classes: {np.int64(1)}\n"]}]},{"cell_type":"code","source":["from sklearn.metrics import classification_report\n","\n","print(\n","    classification_report(\n","        y_true,\n","        y_pred,\n","        labels=[0, 1],\n","        target_names=[\"Non_cracked\", \"Cracked\"],\n","        zero_division=0\n","    )\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"rEorOwmJgEPB","executionInfo":{"status":"ok","timestamp":1789841466670,"user_tz":-330,"elapsed":31,"user":{"displayName":"Revathi Muthukrishnan","userId":"10138192370439535374"}},"outputId":"457002fc-1e0c-48e9-8c0e-4e1e699b0a22"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["              precision    recall  f1-score   support\n","\n"," Non_cracked       0.00      0.00      0.00         0\n","     Cracked       1.00      1.00      1.00      1273\n","\n","    accuracy                           1.00      1273\n","   macro avg       0.50      0.50      0.50      1273\n","weighted avg       1.00      1.00      1.00      1273\n","\n"]}]},{"cell_type":"code","source":["print(\"Actual classes:\", set(y_true))\n","print(\"Predicted classes:\", set(y_pred))\n","print(\"Actual distribution:\", np.bincount(y_true))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"GZYUoFElgJF2","executionInfo":{"status":"ok","timestamp":1789841469326,"user_tz":-330,"elapsed":15,"user":{"displayName":"Revathi Muthukrishnan","userId":"10138192370439535374"}},"outputId":"72c55299-a996-4ca7-dd67-ae7072231437"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Actual classes: {np.int64(1)}\n","Predicted classes: {np.int64(1)}\n","Actual distribution: [   0 1273]\n"]}]},{"cell_type":"code","source":["from sklearn.metrics import confusion_matrix\n","import seaborn as sns\n","\n","cm = confusion_matrix(\n","    y_true,\n","    y_pred\n",")\n","\n","plt.figure(figsize=(6, 5))\n","\n","sns.heatmap(\n","    cm,\n","    annot=True,\n","    fmt=\"d\",\n","    xticklabels=[\"Non_cracked\", \"Cracked\"],\n","    yticklabels=[\"Non_cracked\", \"Cracked\"]\n",")\n","\n","plt.xlabel(\"Predicted\")\n","plt.ylabel(\"Actual\")\n","plt.title(\"Confusion Matrix\")\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":542},"id":"sT7z8LMcclm1","executionInfo":{"status":"ok","timestamp":1789841629390,"user_tz":-330,"elapsed":169,"user":{"displayName":"Revathi Muthukrishnan","userId":"10138192370439535374"}},"outputId":"a491c00e-e017-4f3f-d53f-695f166c4082"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.13/dist-packages/sklearn/metrics/_classification.py:407: UserWarning: A single label was found in 'y_true' and 'y_pred'. For the confusion matrix to have the correct shape, use the 'labels' parameter to pass all known labels.\n","  warnings.warn(\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 600x500 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["def predict_image(image_path):\n","\n","    image = tf.io.read_file(image_path)\n","\n","    image = tf.image.decode_image(\n","        image,\n","        channels=3,\n","        expand_animations=False\n","    )\n","\n","    image = tf.image.resize(\n","        image,\n","        IMG_SIZE\n","    )\n","\n","    image = tf.cast(\n","        image,\n","        tf.float32\n","    )\n","\n","    image_batch = tf.expand_dims(\n","        image,\n","        axis=0\n","    )\n","\n","    probability = model.predict(\n","        image_batch,\n","        verbose=0\n","    )[0][0]\n","\n","    if probability >= 0.5:\n","        prediction = \"Crack\"\n","        confidence = probability\n","    else:\n","        prediction = \"No Crack\"\n","        confidence = 1 - probability\n","\n","    return prediction, confidence"],"metadata":{"id":"Js3hjoCLcziq"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["test_image_path = test_df.iloc[0][\"filepath\"]\n","\n","print(test_image_path)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"uj_TQBqLhQGT","executionInfo":{"status":"ok","timestamp":1789841637468,"user_tz":-330,"elapsed":11,"user":{"displayName":"Revathi Muthukrishnan","userId":"10138192370439535374"}},"outputId":"0fb80e6e-bc50-4f84-eaa6-2168c41874ac"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["/content/drive/MyDrive/Building crack/Decks/Cracked/7012-186.jpg\n"]}]},{"cell_type":"code","source":["prediction, confidence = predict_image(\n","    \"/content/drive/MyDrive/Building crack/Decks/Cracked/7012-186.jpg\"\n",")\n","\n","print(\"Prediction:\", prediction)\n","print(\"Confidence:\", f\"{confidence:.2%}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ljsggIO0gVMc","executionInfo":{"status":"ok","timestamp":1789841641653,"user_tz":-330,"elapsed":159,"user":{"displayName":"Revathi Muthukrishnan","userId":"10138192