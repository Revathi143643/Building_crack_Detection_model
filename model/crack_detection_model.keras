st_split(\n","    df,\n","    test_size=0.30,\n","    random_state=42,\n","    stratify=df[\"stratify_group\"]\n",")"],"metadata":{"id":"CmVGffD_UV5g"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["val_df, test_df = train_test_split(\n","    temp_df,\n","    test_size=0.50,\n","    random_state=42,\n","    stratify=temp_df[\"stratify_group\"]\n",")"],"metadata":{"id":"NCHK3ZOhUahI"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["print(\"Training:\", len(train_df))\n","print(\"Validation:\", len(val_df))\n","print(\"Test:\", len(test_df))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"-sQAVdlTUcAL","executionInfo":{"status":"ok","timestamp":1789836312578,"user_tz":-330,"elapsed":26,"user":{"displayName":"Revathi Muthukrishnan","userId":"10138192370439535374"}},"outputId":"40da3786-0a9d-4181-94de-00c796a6cc2c"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Training: 5938\n","Validation: 1273\n","Test: 1273\n"]}]},{"cell_type":"code","source":["print(\"\\nTraining distribution:\")\n","print(train_df.groupby([\"surface\", \"label\"]).size())\n","\n","print(\"\\nValidation distribution:\")\n","print(val_df.groupby([\"surface\", \"label\"]).size())\n","\n","print(\"\\nTest distribution:\")\n","print(test_df.groupby([\"surface\", \"label\"]).size())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"kkm32ofYUfJt","executionInfo":{"status":"ok","timestamp":1789836317864,"user_tz":-330,"elapsed":40,"user":{"displayName":"Revathi Muthukrishnan","userId":"10138192370439535374"}},"outputId":"210154ea-6229-44ac-bfde-8a8ba69948b8"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Training distribution:\n","surface    label  \n","Decks      Cracked    1417\n","Pavements  Cracked    1826\n","Walls      Cracked    2695\n","dtype: int64\n","\n","Validation distribution:\n","surface    label  \n","Decks      Cracked    304\n","Pavements  Cracked    391\n","Walls      Cracked    578\n","dtype: int64\n","\n","Test distribution:\n","surface    label  \n","Decks      Cracked    304\n","Pavements  Cracked    391\n","Walls      Cracked    578\n","dtype: int64\n"]}]},{"cell_type":"code","source":["IMG_SIZE = (224, 224)\n","BATCH_SIZE = 32"],"metadata":{"id":"8kAKHGnMUiLL"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def create_dataset(dataframe, shuffle=False):\n","\n","    paths = dataframe[\"filepath\"].values\n","    labels = dataframe[\"label_encoded\"].values\n","\n","    dataset = tf.data.Dataset.from_tensor_slices(\n","        (paths, labels)\n","    )\n","\n","    if shuffle:\n","        dataset = dataset.shuffle(\n","            buffer_size=len(dataframe),\n","            seed=42\n","        )\n","\n","    def load_image(path, label):\n","\n","        image = tf.io.read_file(path)\n","\n","        image = tf.image.decode_image(\n","            image,\n","            channels=3,\n","            expand_animations=False\n","        )\n","\n","        image = tf.image.resize(\n","            image,\n","            IMG_SIZE\n","        )\n","\n","        image = tf.cast(image, tf.float32)\n","\n","        return image, label\n","\n","    dataset = dataset.map(\n","        load_image,\n","        num_parallel_calls=tf.data.AUTOTUNE\n","    )\n","\n","    dataset = dataset.batch(BATCH_SIZE)\n","\n","    dataset = dataset.prefetch(\n","        tf.data.AUTOTUNE\n","    )\n","\n","    return dataset"],"metadata":{"id":"kr8MK2AgUlQO"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["train_ds = create_dataset(\n","    train_df,\n","    shuffle=True\n",")\n","\n","val_ds = create_dataset(\n","    val_df\n",")\n","\n","test_ds = create_dataset(\n","    test_df\n",")"],"metadata":{"id":"EOCIr62SUsov"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["plt.figure(figsize=(12, 8))\n","\n","for images, labels in train_ds.take(1):\n","\n","    for i in range(9):\n","\n","        ax = plt.subplot(3, 3, i + 1)\n","\n","        plt.imshow(\n","            images[i].numpy().astype(\"uint8\")\n","        )\n","\n","        label = \"Crack\" if labels[i].numpy() == 1 else \"No Crack\"\n","\n","        plt.title(label)\n","        plt.axis(\"off\")\n","\n","plt.tight_layout()\n","plt.show()\n","plt.figure(figsize=(12, 8))\n","\n","for images, labels in train_ds.take(1):\n","\n","    for i in range(9):\n","\n","        ax = plt.subplot(3, 3, i + 1)\n","\n","        plt.imshow(\n","            images[i].numpy().astype(\"uint8\")\n","        )\n","\n","        label = \"Crack\" if labels[i].numpy() == 1 else \"No Crack\"\n","\n","        plt.title(label)\n","        plt.axis(\"off\")\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"id":"OpDdVYJhUwO0"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["data_augmentation = keras.Sequential([\n","    layers.RandomFlip(\"horizontal\"),\n","    layers.RandomRotation(0.1),\n","    layers.RandomZoom(0.1),\n","], name=\"data_augmentation\")"],"metadata":{"id":"yd_HpHn_UzvJ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["base_model = tf.keras.applications.MobileNetV2(\n","    input_shape=(224, 224, 3),\n","    include_top=False,\n","    weights=\"imagenet\"\n",")"],"metadata":{"id":"q_kkuvDkU8EM","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1789836346636,"user_tz":-330,"elapsed":1581,"user":{"displayName":"Revathi Muthukrishnan","userId":"10138192370439535374"}},"outputId":"33ad169b-3517-4452-ce57-16e9117584c6"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Downloading data from https://storage.googleapis.com/tensorflow/keras-applications/mobilenet_v2/mobilenet_v2_weights_tf_dim_ordering_tf_kernels_1.0_224_no_top.h5\n","\u001b[1m9406464/9406464\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 0us/step\n"]}]},{"cell_type":"code","source":["include_top=False"],"metadata":{"id":"e2qoxgPzVD2P"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["base_model.trainable = False"],"metadata":{"id":"EHTmwzTZVGYl"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["inputs = keras.Input(\n","    shape=(224, 224, 3)\n",")\n","\n","x = data_augmentation(inputs)\n","\n","x = tf.keras.applications.mobilenet_v2.preprocess_input(x)\n","\n","x = base_model(\n","    x,\n","    training=False\n",")\n","\n","x = layers.GlobalAveragePooling2D()(x)\n","\n","x = layers.Dropout(0.3)(x)\n","\n","outputs = layers.Dense(\n","    1,\n","    activation=\"sigmoid\"\n",")(x)\n","\n","model = keras.Model(\n","    inputs,\n","    outputs\n",")"],"metadata":{"id":"kM4DJxP9VKvx"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["layers.Dense(\n","    1,\n","    activation=\"sigmoid\"\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"1digDDx5VM3x","executionInfo":{"status":"ok","timestamp":1789836360597,"user_tz":-330,"elapsed":9,"user":{"displayName":"Revathi Muthukrishnan","userId":"10138192370439535374"}},"outputId":"5aa04aac-baa4-4899-b725-925228b79c26"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["<Dense name=dense_1, built=False>"]},"metadata":{},"execution_count":40}]},{"cell_type":"code","source":["model.compile(\n","    optimizer=keras.optimizers.Adam(\n","        learning_rate=0.0001\n","    ),\n","    loss=\"binary_crossentropy\",\n","    metrics=[\n","        \"accuracy\",\n","        keras.metrics.Precision(name=\"precision\"),\n","        keras.metrics.Recall(name=\"recall\")\n","    ]\n",")"],"metadata":{"id":"U14mkt-bVNcW"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["model.summary()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":417},"id":"etwG90CRVSuO","executionInfo":{"status":"ok","timestamp":1789836366552,"user_tz":-330,"elapsed":5