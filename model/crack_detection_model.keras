n","['Non-cracked', 'Cracked']\n","\n"," PAVEMENTS\n","['Non-cracked', 'Cracked']\n","\n"," WALLS\n","['Non-cracked', 'Cracked']\n"]}]},{"cell_type":"code","source":["from pathlib import Path\n","\n","image_extensions = {\".jpg\", \".jpeg\", \".png\", \".bmp\"}\n","\n","for surface in [\"Decks\", \"Pavements\", \"Walls\"]:\n","\n","    for label in [\"Cracked\", \"Non-cracked\"]:\n","\n","        folder = Path(dataset_path) / surface / label\n","\n","        count = sum(\n","            1 for file in folder.rglob(\"*\")\n","            if file.suffix.lower() in image_extensions\n","        )\n","\n","        print(f\"{surface:10} | {label:10} | {count} images\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zt9xR3U4E7Tb","executionInfo":{"status":"ok","timestamp":1789835667536,"user_tz":-330,"elapsed":8091,"user":{"displayName":"Revathi Muthukrishnan","userId":"10138192370439535374"}},"outputId":"9f95ebb9-1092-43a0-f26c-3948144df0cf"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Decks      | Cracked    | 2025 images\n","Decks      | Non-cracked | 11595 images\n","Pavements  | Cracked    | 2608 images\n","Pavements  | Non-cracked | 21726 images\n","Walls      | Cracked    | 3851 images\n","Walls      | Non-cracked | 14287 images\n"]}]},{"cell_type":"code","source":["import matplotlib.pyplot as plt\n","from PIL import Image\n","from pathlib import Path\n","import random\n","\n","# --------------------------------------------------\n","# 1. Dataset path\n","# --------------------------------------------------\n","dataset_path = Path(dataset_path)\n","\n","# --------------------------------------------------\n","# 2. Image extensions\n","# --------------------------------------------------\n","image_extensions = {\n","    \".jpg\", \".jpeg\", \".png\", \".bmp\", \".webp\"\n","}\n","\n","# --------------------------------------------------\n","# 3. Surface folders\n","# --------------------------------------------------\n","surfaces = [\"Decks\", \"Pavements\", \"Walls\"]\n","\n","# --------------------------------------------------\n","# 4. Check folders and images\n","# --------------------------------------------------\n","for surface in surfaces:\n","\n","    cracked_folder = dataset_path / surface / \"Cracked\"\n","    non_cracked_folder = dataset_path / surface / \"Non_cracked\"\n","\n","    print(f\"\\n{surface}\")\n","    print(\"-\" * 40)\n","\n","    print(\"Cracked folder:\", cracked_folder)\n","    print(\"Exists:\", cracked_folder.exists())\n","\n","    print(\"Non_cracked folder:\", non_cracked_folder)\n","    print(\"Exists:\", non_cracked_folder.exists())\n","\n","    cracked_images = [\n","        file for file in cracked_folder.rglob(\"*\")\n","        if file.is_file() and file.suffix.lower() in image_extensions\n","    ]\n","\n","    non_cracked_images = [\n","        file for file in non_cracked_folder.rglob(\"*\")\n","        if file.is_file() and file.suffix.lower() in image_extensions\n","    ]\n","\n","    print(\"Cracked images:\", len(cracked_images))\n","    print(\"Non_cracked images:\", len(non_cracked_images))\n","\n","\n","# --------------------------------------------------\n","# 5. Display random images\n","# --------------------------------------------------\n","fig, axes = plt.subplots(2, 3, figsize=(15, 8))\n","\n","for col, surface in enumerate(surfaces):\n","\n","    # ==============================\n","    # CRACKED\n","    # ==============================\n","    cracked_folder = dataset_path / surface / \"Cracked\"\n","\n","    cracked_images = [\n","        file for file in cracked_folder.rglob(\"*\")\n","        if file.is_file() and file.suffix.lower() in image_extensions\n","    ]\n","\n","    if len(cracked_images) > 0:\n","\n","        cracked_image = random.choice(cracked_images)\n","\n","        with Image.open(cracked_image) as img:\n","            axes[0, col].imshow(img)\n","\n","        axes[0, col].set_title(f\"{surface} - Cracked\")\n","\n","    else:\n","        axes[0, col].set_title(\n","            f\"{surface} - No Cracked Images\"\n","        )\n","\n","    axes[0, col].axis(\"off\")\n","\n","\n","    # ==============================\n","    # NON-CRACKED\n","    # ==============================\n","    non_cracked_folder = dataset_path / surface / \"Non_cracked\"\n","\n","    non_cracked_images = [\n","        file for file in non_cracked_folder.rglob(\"*\")\n","        if file.is_file() and file.suffix.lower() in image_extensions\n","    ]\n","\n","    if len(non_cracked_images) > 0:\n","\n","        non_cracked_image = random.choice(non_cracked_images)\n","\n","        with Image.open(non_cracked_image) as img:\n","            axes[1, col].imshow(img)\n","\n","        axes[1, col].set_title(\n","            f\"{surface} - Non-Cracked\"\n","        )\n","\n","    else:\n","        axes[1, col].set_title(\n","            f\"{surface} - No Non-Cracked Images\"\n","        )\n","\n","    axes[1, col].axis(\"off\")\n","\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"w4xbyx4tJRLU","executionInfo":{"status":"ok","timestamp":1789835673373,"user_tz":-330,"elapsed":5836,"user":{"displayName":"Revathi Muthukrishnan","userId":"10138192370439535374"}},"outputId":"5c0e609f-976d-4da1-e6c6-967f2ddc8bf3"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Decks\n","----------------------------------------\n","Cracked folder: /content/drive/MyDrive/Building crack/Decks/Cracked\n","Exists: True\n","Non_cracked folder: /content/drive/MyDrive/Building crack/Decks/Non_cracked\n","Exists: False\n","Cracked images: 2025\n","Non_cracked images: 0\n","\n","Pavements\n","----------------------------------------\n","Cracked folder: /content/drive/MyDrive/Building crack/Pavements/Cracked\n","Exists: True\n","Non_cracked folder: /content/drive/MyDrive/Building crack/Pavements/Non_cracked\n","Exists: False\n","Cracked images: 2608\n","Non_cracked images: 0\n","\n","Walls\n","----------------------------------------\n","Cracked folder: /content/drive/MyDrive/Building crack/Walls/Cracked\n","Exists: True\n","Non_cracked folder: /content/drive/MyDrive/Building crack/Walls/Non_cracked\n","Exists: False\n","Cracked images: 3851\n","Non_cracked images: 0\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x800 with 6 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import pandas as pd\n","from pathlib import Path\n","\n","# Image file extensions\n","image_extensions = {\".jpg\", \".jpeg\", \".png\", \".bmp\"}\n","\n","# Empty list to store image information\n","data = []\n","\n","# Your three surface types\n","surfaces = [\"Decks\", \"Pavements\", \"Walls\"]\n","\n","# Your two classes\n","labels = [\"Cracked\", \"Non_cracked\"]\n","\n","# Go through each surface\n","for surface in surfaces:\n","\n","    # Go through crack and no_crack\n","    for label in labels:\n","\n","        # Example:\n","        # building_crack_dataset/decks/crack\n","        folder = Path(dataset_path) / surface / label\n","\n","        # Find all images inside the folder\n","        for file in folder.rglob(\"*\"):\n","\n","            if file.suffix.lower() in image_extensions:\n","\n","                data.append({\n","                    \"filepath\": str(file),\n","                    \"surface\": surface,\n","                    \"label\": label\n","                })\n","\n","# Convert the list into a DataFrame\n","df = pd.DataFrame(data)\n","\n","print(\"Total images:\", len(df))\n","\n","df.head()\n","\n","df[\"label_encoded\"] = df[\"label\"].map({\n","    \"Non_cracked\": 0,\n","    \"Cracked\": 1\n","})\n","\n","df.head()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":223},"id":"IVJcuJ3qKz0P","executionInfo":{"status":"ok","timestamp":1789835682995,"user_tz":-330,"elapsed":637,"user":{"displayName":